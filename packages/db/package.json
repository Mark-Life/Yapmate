{
  "name": "@yapmate/db",
  "type": "module",
  "exports": {
    "./schema": "./src/schema.ts",
    "./service": "./src/service/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "bun --env-file ../../.env.local drizzle-kit generate",
    "generate:custom": "bun --env-file ../../.env.local drizzle-kit generate --custom",
    "migrate": "bun --env-file ../../.env.local drizzle-kit migrate",
    "studio": "bun --env-file ../../.env.local drizzle-kit studio",
    "pull": "bun --env-file ../../.env.local drizzle-kit pull",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:sync": "bash src/scripts/sync_supabase_remote_to_local.sh",
    "supabase:setup": "bun run supabase:start && sleep 3 && bun run supabase:sync"
  },
  "dependencies": {
    "@yapmate/server": "workspace:*",
    "@yapmate/core": "workspace:*",
    "ai": "catalog:",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "postgres": "^3.4.7",
    "zod": "catalog:"
  }
}
