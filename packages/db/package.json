{
  "name": "@yapmate/db",
  "type": "module",
  "exports": {
    "./schema": "./src/schema.ts",
    "./service": "./src/service/index.ts"
  },
  "scripts": {
    "generate": "bun --env-file ../../.env drizzle-kit generate",
    "generate:custom": "bun --env-file ../../.env drizzle-kit generate --custom",
    "migrate": "bun --env-file ../../.env drizzle-kit migrate",
    "studio": "bun --env-file ../../.env drizzle-kit studio",
    "pull": "bun --env-file ../../.env drizzle-kit pull"
  },
  "dependencies": {
    "@yapmate/server": "workspace:*",
    "ai": "catalog:",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "postgres": "^3.4.7",
    "zod": "catalog:"
  }
}
