{
  "expo": {
    "name": "Yapmate",
    "slug": "yapmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/YAP-512x512.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "yapmate",
    "splash": {
      "image": "./assets/images/YAP-512x512.png",
      "resizeMode": "contain",
      "backgroundColor": "#020000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mark-life.yapmate",
      "icon": "./assets/yapmate-apple-2-dark.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "96ZJ439B4W"
    },
    "android": {
      "adaptiveIcon": {
        "image": "./assets/yapmate-apple-2-dark.icon/Assets/YAP.svg",
        "backgroundColor": "#0a0a0a"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.marklife.yapmate",
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera"
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d495901c-3363-4686-a32e-fb09c86e4789"
      }
    },
    "owner": "mark-life-ltd",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d495901c-3363-4686-a32e-fb09c86e4789"
    }
  }
}
