{
  "cli": {
    "requireCommit": false
  },
  "build": {
    "base": {
      "node": "20.18.0",
      "bun": "1.3.5"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      },
      "channel": "development"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "preview"
      },
      "channel": "preview"
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "env": {
        "APP_VARIANT": "production"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "companyName": "Mark Life Ltd",
        "ascAppId": "6757226545"
      }
    }
  }
}
