{
  "name": "@yapmate/video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render PromoVideo --output=out/promo.mp4",
    "render:vertical": "remotion render PromoVideoVertical --output=out/promo-vertical.mp4",
    "render:square": "remotion render PromoVideoSquare --output=out/promo-square.mp4",
    "render:all": "bun run render && bun run render:vertical && bun run render:square",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.407",
    "@remotion/google-fonts": "4.0.407",
    "@remotion/transitions": "4.0.407",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remotion": "4.0.407"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
