{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Yapmate",
  "version": "0.1.0",
  "identifier": "com.mark-life.yapmate",
  "build": {
    "frontendDist": "../web/dist/client",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "cd ../../.. && bun --filter '@yapmate/web' dev",
    "beforeBuildCommand": "cd ../../.. && bun --filter '@yapmate/web' build"
  },
  "app": {
    "windows": [
      {
        "title": "Yapmate",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": null,
      "info": {
        "CFBundleURLTypes": [],
        "LSMinimumSystemVersion": "10.13"
      }
    }
  }
}
