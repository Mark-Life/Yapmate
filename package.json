{
  "name": "yapmate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '@yapmate/web' dev",
    "build": "bun --filter '@yapmate/web' build",
    "start": "bun --filter '@yapmate/web' start",
    "dev:local": "bun scripts/use-local-bun.ts --filter '@yapmate/web' dev",
    "build:local": "bun scripts/use-local-bun.ts --filter '@yapmate/web' build",
    "start:local": "bun scripts/use-local-bun.ts --filter '@yapmate/web' start",
    "dev:desktop": "bun --filter '@yapmate/desktop' dev",
    "build:desktop": "bun --filter '@yapmate/desktop' build",
    "lint": "biome check",
    "typecheck": "tsc -b",
    "format": "biome format --write",
    "db:generate": "bun --filter '@yapmate/db' generate",
    "db:generate:custom": "bun --filter '@yapmate/db' generate:custom",
    "db:migrate": "bun --filter '@yapmate/db' migrate",
    "db:studio": "bun --filter '@yapmate/db' studio",
    "db:pull": "bun --filter '@yapmate/db' pull"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@tauri-apps/cli": "^2.9.6",
    "@types/bun": "^1.3.5",
    "@types/node": "^20",
    "@types/sharp": "^0.32.0",
    "sharp": "^0.34.5",
    "typescript": "catalog:",
    "ultracite": "6.4.2"
  },
  "catalog": {
    "ai": "^6.0.27",
    "sonner": "^2.0.7",
    "typescript": "^5",
    "streamdown": "^1.6.10",
    "lucide-react": "^0.562.0",
    "react-hook-form": "^7.68.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@supabase/supabase-js": "^2.89.0",
    "@supabase/ssr": "^0.8.0",
    "next-themes": "^0.4.6",
    "tw-animate-css": "^1.4.0",
    "@orpc/client": "^1.13.0",
    "@orpc/server": "^1.13.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "bun": "link:."
  }
}
